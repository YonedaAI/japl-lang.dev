---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout title="The JAPL Programming Language" description="A strict typed functional programming language with Rust ownership, Erlang processes, and Go simplicity.">
  <Nav />

  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <div class="hero-content">
        <h1 class="hero-title">
          <span class="hero-accent">J</span>APL
        </h1>
        <p class="hero-subtitle">
          Strict typed functional programming.<br/>
          <span class="hero-highlight">Rust</span> ownership.
          <span class="hero-highlight">Erlang</span> processes.
          <span class="hero-highlight">Go</span> simplicity.
        </p>
        <div class="hero-cta">
          <a href="/docs/tour/01-values" class="btn btn-primary">Start the Tour</a>
          <a href="https://github.com/YonedaAI/japl" class="btn btn-secondary" target="_blank" rel="noopener">GitHub</a>
        </div>
      </div>
      <div class="hero-code">
        <pre class="hero-code-block"><code><span class="c">-- A typed web server with process-based concurrency</span>

<span class="k">type</span> <span class="t">Request</span> =
  | <span class="t">Get</span>(<span class="t">String</span>)
  | <span class="t">Post</span>(<span class="t">String</span>, <span class="t">Body</span>)

<span class="k">type</span> <span class="t">Response</span> =
  | <span class="t">Ok</span>(<span class="t">Body</span>)
  | <span class="t">NotFound</span>
  | <span class="t">Error</span>(<span class="t">String</span>)

<span class="k">fn</span> <span class="f">handle</span>(req: <span class="t">Request</span>) -> <span class="t">Response</span> = <span class="k">match</span> req <span class="k">with</span>
  | <span class="t">Get</span>(<span class="s">"/health"</span>)    -> <span class="t">Ok</span>(<span class="s">"ok"</span>)
  | <span class="t">Get</span>(path)         -> <span class="v">lookup</span>(path)
  | <span class="t">Post</span>(path, body)  -> <span class="v">store</span>(path, body)

<span class="k">fn</span> <span class="f">counter</span>(count: <span class="t">Int</span>) -> <span class="t">Int</span> = <span class="k">receive</span>
  | <span class="t">Increment</span>(n) -> <span class="v">counter</span>(count + n)
  | <span class="t">GetCount</span>     -> count
  | <span class="t">Shutdown</span>     -> count

<span class="k">fn</span> <span class="f">main</span>() -> <span class="t">Result</span>[<span class="t">Unit</span>, <span class="t">Error</span>] =
  <span class="k">let</span> pid = <span class="v">spawn</span>(<span class="v">counter</span>, <span class="n">0</span>)
  <span class="k">let</span> server = <span class="v">listen</span>(<span class="n">8080</span>, <span class="v">handle</span>)
  <span class="v">supervise</span>([pid, server], <span class="t">OneForOne</span>)</code></pre>
      </div>
    </div>
  </section>

  <!-- Core Principles -->
  <section class="principles">
    <div class="container">
      <h2 class="section-title">Core Principles</h2>
      <div class="principles-grid">
        <div class="principle-card">
          <h3>Strict Types</h3>
          <p>Full Hindley-Milner inference with algebraic data types. No nulls, no exceptions — only typed values.</p>
        </div>
        <div class="principle-card">
          <h3>Ownership</h3>
          <p>Rust-style affine types without a borrow checker. Move semantics prevent data races at compile time.</p>
        </div>
        <div class="principle-card">
          <h3>Processes</h3>
          <p>Erlang-style lightweight processes with typed message passing. Supervision trees built into the language.</p>
        </div>
        <div class="principle-card">
          <h3>Expression-Oriented</h3>
          <p>Everything is an expression. Pattern matching, if/else, and blocks all return values.</p>
        </div>
        <div class="principle-card">
          <h3>Immutable First</h3>
          <p>Values are immutable by default. Mutation is explicit, scoped, and tracked by the type system.</p>
        </div>
        <div class="principle-card">
          <h3>Pipe-Forward</h3>
          <p>Data flows left-to-right with |&gt; pipes. Function composition with &gt;&gt;. No nested parentheses.</p>
        </div>
        <div class="principle-card">
          <h3>Simple Syntax</h3>
          <p>Go-level readability with ML-level power. Minimal keywords, consistent structure, no ceremony.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Language DNA -->
  <section class="dna">
    <div class="container">
      <h2 class="section-title">Language DNA</h2>
      <p class="section-desc">JAPL combines the best ideas from four language families into one coherent design.</p>
      <div class="dna-grid">
        <div class="dna-card" style="--dna-color: var(--ml);">
          <div class="dna-label">ML / Haskell</div>
          <h3>Type System</h3>
          <p>Hindley-Milner inference, algebraic data types, pattern matching, type classes as traits.</p>
        </div>
        <div class="dna-card" style="--dna-color: var(--rust);">
          <div class="dna-label">Rust</div>
          <h3>Ownership</h3>
          <p>Affine types, move semantics, zero-cost abstractions, WASM compilation target.</p>
        </div>
        <div class="dna-card" style="--dna-color: var(--erlang);">
          <div class="dna-label">Erlang / Elixir</div>
          <h3>Concurrency</h3>
          <p>Lightweight processes, message passing, supervision trees, fault tolerance.</p>
        </div>
        <div class="dna-card" style="--dna-color: var(--go);">
          <div class="dna-label">Go</div>
          <h3>Simplicity</h3>
          <p>Fast compilation, minimal syntax, easy tooling, single-binary deployment.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Compiler Architecture -->
  <section class="compiler">
    <div class="container">
      <h2 class="section-title">Compiler Architecture</h2>
      <p class="section-desc">A multi-stage pipeline from source to WASM, with type checking at every stage.</p>
      <div class="compiler-stages">
        <div class="stage-card">
          <div class="stage-num">1</div>
          <h3>Lexer</h3>
          <p>Tokenizes JAPL source into a typed token stream</p>
        </div>
        <div class="stage-arrow">&#8594;</div>
        <div class="stage-card">
          <div class="stage-num">2</div>
          <h3>Parser</h3>
          <p>Builds a concrete syntax tree with full span tracking</p>
        </div>
        <div class="stage-arrow">&#8594;</div>
        <div class="stage-card">
          <div class="stage-num">3</div>
          <h3>Type Checker</h3>
          <p>Hindley-Milner inference with ownership analysis</p>
        </div>
        <div class="stage-arrow">&#8594;</div>
        <div class="stage-card">
          <div class="stage-num">4</div>
          <h3>Codegen</h3>
          <p>Emits WebAssembly text format (WAT)</p>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  /* Hero */
  .hero {
    padding: 80px 0 100px;
    position: relative;
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    top: -200px;
    left: 50%;
    transform: translateX(-50%);
    width: 800px;
    height: 800px;
    background: radial-gradient(circle, var(--accent-glow) 0%, transparent 70%);
    pointer-events: none;
  }

  .hero .container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
    position: relative;
  }

  .hero-title {
    font-size: 5rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 20px;
  }

  .hero-accent {
    color: var(--accent);
  }

  .hero-subtitle {
    font-size: 1.25rem;
    color: var(--text-dim);
    line-height: 1.7;
    margin-bottom: 32px;
  }

  .hero-highlight {
    color: var(--text);
    font-weight: 600;
  }

  .hero-cta {
    display: flex;
    gap: 16px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: 12px 28px;
    border-radius: var(--radius);
    font-weight: 600;
    font-size: 0.9rem;
    transition: all 0.2s;
  }

  .btn-primary {
    background: var(--accent);
    color: white;
  }

  .btn-primary:hover {
    background: #6b4ae0;
    color: white;
  }

  .btn-secondary {
    background: var(--surface-2);
    color: var(--text);
    border: 1px solid var(--border);
  }

  .btn-secondary:hover {
    border-color: var(--accent);
    color: var(--text);
  }

  .hero-code-block {
    background: var(--code-bg) !important;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 28px;
    font-size: 0.8rem;
    line-height: 1.7;
    overflow-x: auto;
  }

  .hero-code-block .c { color: #6a737d; }
  .hero-code-block .k { color: #ff7b72; }
  .hero-code-block .t { color: #79c0ff; }
  .hero-code-block .f { color: #d2a8ff; }
  .hero-code-block .s { color: #a5d6ff; }
  .hero-code-block .v { color: #c9d1d9; }
  .hero-code-block .n { color: #79c0ff; }

  /* Section headings */
  .section-title {
    font-size: 2rem;
    font-weight: 800;
    text-align: center;
    margin-bottom: 12px;
  }

  .section-desc {
    text-align: center;
    color: var(--text-dim);
    max-width: 600px;
    margin: 0 auto 48px;
  }

  /* Core Principles */
  .principles {
    padding: 100px 0;
  }

  .principles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
    margin-top: 48px;
  }

  .principle-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 28px;
    transition: border-color 0.2s;
  }

  .principle-card:hover {
    border-color: var(--accent);
  }

  .principle-card h3 {
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 8px;
    color: var(--text);
  }

  .principle-card p {
    color: var(--text-dim);
    font-size: 0.9rem;
    line-height: 1.6;
    margin-bottom: 0;
  }

  /* Language DNA */
  .dna {
    padding: 100px 0;
    background: var(--surface);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .dna-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  .dna-card {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 28px;
    border-top: 3px solid var(--dna-color);
    transition: border-color 0.2s;
  }

  .dna-card:hover {
    border-color: var(--dna-color);
  }

  .dna-label {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--dna-color);
    margin-bottom: 12px;
  }

  .dna-card h3 {
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 8px;
  }

  .dna-card p {
    color: var(--text-dim);
    font-size: 0.875rem;
    line-height: 1.6;
    margin-bottom: 0;
  }

  /* Compiler Architecture */
  .compiler {
    padding: 100px 0;
  }

  .compiler-stages {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-bottom: 48px;
    flex-wrap: wrap;
  }

  .stage-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 24px;
    text-align: center;
    flex: 0 1 200px;
  }

  .stage-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--accent-dim);
    color: var(--accent);
    font-weight: 700;
    font-size: 0.85rem;
    margin-bottom: 12px;
  }

  .stage-card h3 {
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 6px;
  }

  .stage-card p {
    color: var(--text-dim);
    font-size: 0.8rem;
    line-height: 1.5;
    margin-bottom: 0;
  }

  .stage-arrow {
    color: var(--muted);
    font-size: 1.5rem;
  }


  /* Responsive */
  @media (max-width: 900px) {
    .hero .container {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .hero-title {
      font-size: 3.5rem;
    }

    .dna-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding: 48px 0 64px;
    }

    .hero-title {
      font-size: 2.5rem;
    }

    .hero-subtitle {
      font-size: 1.05rem;
    }

    .hero-cta {
      flex-direction: column;
    }

    .dna-grid {
      grid-template-columns: 1fr;
    }

    .compiler-stages {
      flex-direction: column;
    }

    .stage-arrow {
      transform: rotate(90deg);
    }

  }
</style>
