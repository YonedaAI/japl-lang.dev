---
---
<footer class="footer">
  <div class="footer-inner container">
    <div class="footer-brand">
      <span class="footer-logo"><span class="footer-logo-accent">J</span>APL</span>
      <p class="footer-tagline">A typed actor language for reliable distributed systems and AI agents.<br/>Compiles to WASM. Runs on a Rust runtime.</p>
    </div>
    <div class="footer-links">
      <div class="footer-col">
        <h4>Learn</h4>
        <a href="/docs/tour/01-values">Language Tour</a>
        <a href="/docs/guide/01-type-system">Guide</a>
        <a href="/docs/reference/01-spec">Reference</a>
      </div>
      <div class="footer-col">
        <h4>Community</h4>
        <a href="https://github.com/YonedaAI/japl" target="_blank" rel="noopener">GitHub</a>
        <a href="https://github.com/YonedaAI/japl/issues" target="_blank" rel="noopener">Issues</a>
      </div>
    </div>
    <div class="footer-bottom">
      <p>Built by <a href="https://yonedaai.com" target="_blank" rel="noopener">YonedaAI</a></p>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    padding: 64px 0 32px;
    margin-top: 80px;
    background: var(--surface);
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
  }

  .footer-logo {
    font-weight: 800;
    font-size: 1.5rem;
    color: var(--text);
  }

  .footer-logo-accent {
    color: var(--accent);
  }

  .footer-tagline {
    margin-top: 12px;
    color: var(--text-dim);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .footer-links {
    display: flex;
    gap: 64px;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .footer-col h4 {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    margin-bottom: 4px;
  }

  .footer-col a {
    color: var(--text-dim);
    font-size: 0.875rem;
  }

  .footer-col a:hover {
    color: var(--text);
  }

  .footer-bottom {
    grid-column: 1 / -1;
    padding-top: 32px;
    border-top: 1px solid var(--border);
    text-align: center;
  }

  .footer-bottom p {
    font-size: 0.8rem;
    color: var(--muted);
  }

  @media (max-width: 640px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>
