---
interface Props {
  currentSlug?: string;
}

const { currentSlug } = Astro.props;

const sections = [
  {
    title: 'Tour',
    links: [
      { title: 'Values & Bindings', slug: 'docs/tour/01-values' },
      { title: 'Types', slug: 'docs/tour/02-types' },
      { title: 'Functions', slug: 'docs/tour/03-functions' },
      { title: 'Pattern Matching', slug: 'docs/tour/04-pattern-matching' },
      { title: 'Algebraic Types', slug: 'docs/tour/05-algebraic-types' },
      { title: 'Error Handling', slug: 'docs/tour/06-error-handling' },
      { title: 'Ownership', slug: 'docs/tour/07-ownership' },
      { title: 'Processes', slug: 'docs/tour/08-processes' },
      { title: 'Modules', slug: 'docs/tour/09-modules' },
      { title: 'Traits', slug: 'docs/tour/10-traits' },
    ],
  },
  {
    title: 'Guide',
    links: [
      { title: 'Type System', slug: 'docs/guide/01-type-system' },
      { title: 'Ownership & Linearity', slug: 'docs/guide/02-ownership' },
      { title: 'Effect System', slug: 'docs/guide/03-effects' },
      { title: 'Process Model', slug: 'docs/guide/04-processes' },
      { title: 'Supervision Trees', slug: 'docs/guide/05-supervision' },
      { title: 'Distribution', slug: 'docs/guide/06-distribution' },
      { title: 'Error Handling', slug: 'docs/guide/07-errors' },
      { title: 'Modules & Imports', slug: 'docs/guide/08-modules' },
      { title: 'Traits', slug: 'docs/guide/09-traits' },
      { title: 'Records', slug: 'docs/guide/10-records' },
      { title: 'Testing', slug: 'docs/guide/11-testing' },
      { title: 'Compiler Internals', slug: 'docs/guide/12-compiler' },
    ],
  },
  {
    title: 'Reference',
    links: [
      { title: 'Language Specification', slug: 'docs/reference/01-spec' },
      { title: 'Grammar', slug: 'docs/reference/02-grammar' },
      { title: 'CLI Reference', slug: 'docs/reference/03-cli' },
      { title: 'Configuration', slug: 'docs/reference/04-config' },
      { title: 'Wire Protocol', slug: 'docs/reference/05-wire' },
    ],
  },
];
---
<aside class="docs-sidebar">
  <div class="docs-sidebar-logo">
    <a href="/"><span>J</span>APL</a>
  </div>
  {sections.map(section => (
    <div class="sidebar-section">
      <div class="sidebar-section-title">{section.title}</div>
      {section.links.map(link => (
        <a
          href={`/${link.slug}`}
          class:list={['sidebar-link', { active: currentSlug === link.slug }]}
        >
          {link.title}
        </a>
      ))}
    </div>
  ))}
</aside>
